[Unit]
Description=Unerkannte Shoko-Dateien nach Regel oder mit Claude zuordnen
After=docker.service

[Service]
Type=oneshot
User=shoko-zuordnung
Group=shoko-zuordnung
WorkingDirectory=/opt/media-stack/shoko-zuordnung
ExecStart=/opt/media-stack/shoko-zuordnung/venv/bin/python zuordnen.py
Environment=PYTHONDONTWRITEBYTECODE=1
TimeoutStartSec=30min
MemoryMax=256M
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/shoko-zuordnung
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
CapabilityBoundingSet=
